# Banco da lista (Neon). Sem isto, em produção, a lista fica fora do ar de propósito.
DATABASE_URL=

# Senha da portaria (/lista). Mínimo de 6 caracteres. Sem isto, /lista fica trancada.
LISTA_SENHA=

# Opcional: endereço final do site (domínio próprio), usado nos links de compartilhamento.
SITE_URL=

# Só no computador: LISTA_TESTE=1 abre a lista para testar o formulário e a portaria antes de liberar de verdade.
# Não tem efeito em produção.
# LISTA_TESTE=1
